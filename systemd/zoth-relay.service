# Template — install.sh fills @HOME@ / @PREFIX@ and copies this to /etc/systemd/system/.
[Unit]
Description=zoth-relay (multi-agent local bridge for ZOTHOS / Parrot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zoth-relay
Group=zoth-relay
Environment=ZOTH_RELAY_CONFIG=/etc/zoth-relay/config.yaml
Environment=HOME=@HOME@
WorkingDirectory=@HOME@/agent-workspace
ExecStart=@PREFIX@/venv/bin/python -m zoth_relay serve
Restart=on-failure
RestartSec=3

# --- hardening (the real sandbox; the command blocklist is only defence-in-depth) ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@HOME@
ReadWritePaths=@HOME@ /var/log/zoth-relay
# agents.yaml is hot-reloaded but read-only to the service (root:zoth-relay 0640)
ReadOnlyPaths=/etc/zoth-relay
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=256
MemoryMax=2G
UMask=0027

[Install]
WantedBy=multi-user.target
