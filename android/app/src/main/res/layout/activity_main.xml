<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentCol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. Brand Header Row: Title + Braille on Left, Dev Mode Toggle on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spotter"
                        android:textColor="#0F172A"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/brailleWordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:text="⠎⠏⠕⠞⠞⠑⠗"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:id="@+id/brailleSpin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:text="⠋"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FieldKit by NullAI · your mission coach"
                    android:textColor="#475569"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMainDevToggle"
                android:contentDescription="Toggle developer and advanced settings"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_btn_light"
                android:singleLine="true"
                android:text="⚙ Dev"
                android:textAllCaps="false"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Spacious Quick Utility Bar (CC Captions | Conversations | Record Demo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMainCaptions"
                android:contentDescription="Toggle live AI captions"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.85"
                android:minHeight="42dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="6dp"
                android:background="@drawable/bg_accent_emerald"
                android:singleLine="true"
                android:text="CC: ON"
                android:textAllCaps="false"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMainChats"
                android:contentDescription="View or start conversations"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.95"
                android:minHeight="42dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="6dp"
                android:background="@drawable/bg_dark_pill"
                android:singleLine="true"
                android:text="💬 Chats"
                android:textAllCaps="false"
                android:textColor="#7DD3FC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRecDemo"
                android:contentDescription="Record live demo video"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.1"
                android:minHeight="42dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="6dp"
                android:background="@drawable/bg_dark_pill"
                android:singleLine="true"
                android:text="● REC Demo"
                android:textAllCaps="false"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMainRtmp"
                android:contentDescription="Configure RTMP live streaming"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.0"
                android:minHeight="42dp"
                android:paddingHorizontal="6dp"
                android:background="@drawable/bg_dark_pill"
                android:singleLine="true"
                android:text="📡 RTMP"
                android:textAllCaps="false"
                android:textColor="#FDE68A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <tech.nullai.fieldkit.DitherStripView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp" />

        <tech.nullai.fieldkit.BrailleStripView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginBottom="12dp"
            android:importantForAccessibility="no" />

        <!-- Spotter Persona Mode Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SPOTTER MODE &amp; OBJECTIVE"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMainVoiceTriggers"
                android:contentDescription="12 Hands-free voice triggers cheat sheet"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minHeight="28dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:background="@drawable/bg_dark_pill"
                android:text="🗣️ 12 Triggers"
                android:textAllCaps="false"
                android:textColor="#FDE68A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mainModeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMainModeIntel"
                android:contentDescription="Intel &amp; People Mode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_accent_emerald"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="#34D399"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="👥 Intel" />

            <Button
                android:id="@+id/btnMainModeGodVoice"
                android:contentDescription="Subconscious God's Voice Mode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.25"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dark_pill"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="👁️ Subconscious" />

            <Button
                android:id="@+id/btnMainModeCoder"
                android:contentDescription="Vibe Coder Screen Wingman Mode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.15"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dark_pill"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="⚡ Vibe Coder" />

            <Button
                android:id="@+id/btnMainModeCustom"
                android:contentDescription="Custom Goal Directive Mode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_pill"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="🎯 Goal" />
        </LinearLayout>

        <!-- 3. Camera Source Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA SOURCE"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill"
            android:padding="4dp">

            <Button
                android:id="@+id/btnSrcPhone"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="Phone Camera"
                android:textColor="#0F172A"
                android:background="@drawable/bg_seg_on" />

            <Button
                android:id="@+id/btnSrcGlasses"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="Meta Glasses"
                android:textColor="#0F172A"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- 4. Live Camera Viewfinder Card -->
        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="215dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card">

            <TextureView
                android:id="@+id/preview"
                android:contentDescription="Live camera preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ivGlasses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Meta glasses camera view"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnFull"
                android:contentDescription="Open full screen preview"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_dark_pill"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:text="⛶ Full" />

            <Button
                android:id="@+id/btnFab"
                android:contentDescription="Open Spotter options menu"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_dark_pill"
                android:textColor="#FFFFFF"
                android:text="☰"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGlasses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="20dp"
                android:text="Meta glasses\nWaiting for the first real frame…"
                android:textAlignment="center"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRecBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_dark_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="● REC 00:00"
                android:textColor="#FCA5A5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVisionTicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="8dp"
                android:layout_marginTop="42dp"
                android:layout_marginEnd="85dp"
                android:background="@drawable/bg_dark_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="👁️ Vision Memory · Active"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_dark_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Stream idle"
                android:textColor="#F8FAFC"
                android:textSize="10.5sp" />
        </FrameLayout>

        <!-- 5. Live AI Model / Agent Captions Banner -->
        <TextView
            android:id="@+id/tvMainLiveCaptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dark_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13.5sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <!-- 6. Live Recognized Person Character Card Popup (4 angles + detailed info chart) -->
        <LinearLayout
            android:id="@+id/mainPersonCardOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- 7. Current Step & Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CURRENT STEP"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="34dp"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:text="Connect"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mission yet"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter a goal below or start a live Muse call."
                android:textColor="#334155"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 8. Mission Goal Input + Start + Demo Goals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etGoal"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:paddingHorizontal="14dp"
                android:hint="What do you want help with?"
                android:textColor="#0F172A"
                android:textColorHint="#64748B"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnMission"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:text="▶ Start"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_dark"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btnDemoGoals"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="⚡ Ideas"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:background="@drawable/bg_btn_light" />
        </LinearLayout>

        <!-- 9. Everyday Action Row 1: Talk | Pause | Next Step (No wrapping or clipping!) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnTalk"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="◉ Talk"
                android:textColor="#0F172A"
                android:background="@drawable/bg_btn_light" />

            <Button
                android:id="@+id/btnShh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.9"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="⏸ Pause"
                android:textColor="#0F172A"
                android:background="@drawable/bg_btn_light" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.15"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="✔ Next Step"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_dark" />
        </LinearLayout>

        <!-- 10. Everyday Action Row 2: Live Muse Call | Save Person | Saved People -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_btn_dark"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="☎ Live Call"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPerson"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.15"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="◆ Save Person"
                android:textColor="#0F172A"
                android:background="@drawable/bg_btn_light" />

            <Button
                android:id="@+id/btnMainPeople"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.95"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:text="People"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:background="@drawable/bg_btn_light" />
        </LinearLayout>

        <!-- 11. Collapsible Developer & Advanced Controls Drawer -->
        <LinearLayout
            android:id="@+id/devControlsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvDevDrawerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="▸ Developer &amp; Advanced Settings (Relay, Voice Gate, Sensors)"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/devControlsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENSOR &amp; ACOUSTIC TELEMETRY"
                    android:textColor="#475569"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Heading —"
                    android:textColor="#0F172A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Sound —"
                    android:textColor="#0F172A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="COACH OPTIMIZATION &amp; SPEAKER GATE"
                    android:textColor="#475569"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPreset"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="Preset: Get It Done"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="12.5sp"
                        android:textColor="#0F172A"
                        android:background="@drawable/bg_btn_light" />

                    <Button
                        android:id="@+id/btnVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="12.5sp"
                        android:text="◎ Voice Gate"
                        android:textColor="#0F172A"
                        android:background="@drawable/bg_btn_light" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="11.5sp"
                    android:textColor="#334155"
                    android:text="◎ Voice gate: not enrolled. Tap Voice Gate to teach it yours (3 takes)." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="RELAY SERVER &amp; PAIRING"
                    android:textColor="#475569"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:text="Scan QR to Pair Relay"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_dark" />

                <EditText
                    android:id="@+id/etRelay"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="12dp"
                    android:hint="Relay address (http://...)"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:textSize="13.5sp"
                    android:background="@drawable/bg_input"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etToken"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="12dp"
                    android:hint="Relay token"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:textSize="13.5sp"
                    android:background="@drawable/bg_input"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
