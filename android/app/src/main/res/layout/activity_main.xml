<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentCol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spotter"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brailleWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="⠎⠏⠕⠞⠞⠑⠗"
                android:textColor="#6B707B"
                android:textSize="15sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/brailleSpin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:text="⠋"
                android:textColor="#1E2026"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FieldKit by NullAI · your mission coach"
            android:textColor="#444444"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCompass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heading —"
            android:textColor="#444444"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound —"
            android:textColor="#444444"
            android:textSize="12sp" />

        <tech.nullai.fieldkit.DitherStripView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <tech.nullai.fieldkit.BrailleStripView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA SOURCE"
            android:textColor="#444444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill"
            android:padding="4dp">

            <Button
                android:id="@+id/btnSrcPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phone camera"
                android:textColor="#111111"
                android:background="@drawable/bg_seg_on" />

            <Button
                android:id="@+id/btnSrcGlasses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meta glasses"
                android:textColor="#111111"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card">

            <TextureView
                android:id="@+id/preview"
                android:contentDescription="Live camera preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ivGlasses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Meta glasses camera view"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnFull"
            android:contentDescription="Open full screen preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:text="⛶ Full" />

            <Button
                android:id="@+id/btnFab"
            android:contentDescription="Open Spotter options menu"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:text="☰"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGlasses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="20dp"
                android:text="Meta glasses\nWaiting for the first real frame…"
                android:textAlignment="center"
                android:textColor="#333333"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <tech.nullai.fieldkit.DitherStripView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT STEP"
                android:textColor="#444444"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mission yet"
                android:textColor="#111111"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan the relay code, or enter it below."
                android:textColor="#444444"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan QR to connect"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_dark"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etRelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Relay address"
            android:textColor="#111111"
            android:textColorHint="#888888"
            android:background="@drawable/bg_input"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Relay token"
            android:textColor="#111111"
            android:textColorHint="#888888"
            android:background="@drawable/bg_input"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:textColor="#111111"
            android:background="@drawable/bg_btn_light"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <EditText
                android:id="@+id/etGoal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Goal — replace the air filter"
                android:textColor="#111111"
                android:textColorHint="#888888"
                android:background="@drawable/bg_input"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnMission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ Start"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_dark"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preset: Get It Done"
            android:textColor="#111111"
            android:background="@drawable/bg_btn_light"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnTalk"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="◉ Talk"
                android:textColor="#111111"
                android:background="@drawable/bg_btn_light" />

            <Button
                android:id="@+id/btnShh"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏸ Shh"
                android:textColor="#111111"
                android:background="@drawable/bg_btn_light"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btnNext"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✔ Done — next step"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_dark"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnVoice"
                android:minHeight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9678; Voice"
                android:textColor="#111111"
                android:background="@drawable/bg_btn_light" />

            <Button
                android:id="@+id/btnPerson"
                android:minHeight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="&#9670; Name"
                android:textColor="#111111"
                android:background="@drawable/bg_btn_light" />

            <TextView
                android:id="@+id/tvVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="11sp"
                android:textColor="#E8F0F5"
                android:alpha="0.85"
                android:gravity="center_vertical"
                android:text="&#9674; Voice gate: not enrolled. Tap Voice to teach it yours (3 takes)." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
